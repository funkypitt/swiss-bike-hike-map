<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView style="@style/MenuHead" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ROUTING DATA (OpenStreetMap via brouter.de)"/>
        <TextView android:id="@+id/segInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="monospace" android:lineSpacingExtra="4dp"/>
        <TextView android:id="@+id/btnSegments" style="@style/Btn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="DOWNLOAD / UPDATE"/>

        <TextView style="@style/MenuHead" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OFFLINE MAPS (swisstopo)"/>
        <TextView android:id="@+id/offlineInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:lineSpacingExtra="4dp"/>
        <TextView android:id="@+id/btnOfflineArea" style="@style/Btn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="SAVE THE AREA LAST SHOWN"/>
        <TextView android:id="@+id/btnOfflineRefresh" style="@style/Btn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="REFRESH SAVED AREAS"/>
        <TextView android:id="@+id/btnOfflineDelete" style="@style/Btn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="DELETE SAVED AREAS"/>

        <TextView style="@style/MenuHead" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PAPER MAP 1:25 000"/>
        <TextView android:id="@+id/paperInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:lineSpacingExtra="4dp"/>

        <TextView style="@style/MenuHead" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TRACKS"/>
        <TextView android:id="@+id/btnImport" style="@style/Btn" android:layout_width="match_parent" android:layout_height="56dp" android:text="SHOW A GPX FILE ON THE MAP"/>

        <TextView style="@style/MenuHead" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ABOUT"/>
        <TextView android:id="@+id/about" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
    </LinearLayout>
</ScrollView>
