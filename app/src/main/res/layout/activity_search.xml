<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/paper" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/btnPlaces" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:autoSizeMaxTextSize="15sp" android:text="@string/places"/>
        <TextView android:id="@+id/btnPeople" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1.2"
            android:layout_height="48dp" android:layout_marginStart="6dp" android:autoSizeMaxTextSize="15sp" android:text="@string/people"/>
        <TextView android:id="@+id/btnStops" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginStart="6dp" android:autoSizeMaxTextSize="15sp" android:text="@string/stops"/>
        <TextView android:id="@+id/btnFavs" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginStart="6dp" android:autoSizeMaxTextSize="15sp" android:text="@string/favourites"/>
    </LinearLayout>
    <EditText android:id="@+id/query" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="8dp" android:hint="@string/search_hint" android:textSize="20sp" android:inputType="text"
        android:imeOptions="actionSearch" android:background="@drawable/btn" android:paddingStart="14dp"
        android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/grey"
        android:singleLine="true"/>
    <TextView android:id="@+id/credit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/grey" android:paddingTop="6dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/favRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="8dp" android:visibility="gone">
        <TextView android:id="@+id/btnImport" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="@string/import_places"/>
        <TextView android:id="@+id/btnExport" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginStart="6dp" android:text="@string/export_places"/>
    </LinearLayout>
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="8dp" android:divider="@color/ink" android:dividerHeight="1dp"/>
</LinearLayout>
