<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ink">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/map"
            android:layout_width="match_parent" android:layout_height="match_parent"/>

        <!-- top row: mode badge left, FIND + MENU right -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false" android:padding="8dp" android:gravity="top">
            <FrameLayout android:id="@+id/modeBadge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                android:background="@drawable/badge_walk" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/modeBadgeText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:maxLines="1"
                    android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp"
                    android:gravity="center" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.12" android:text="@string/walk"/>
            </FrameLayout>
            <TextView android:id="@+id/btnPlaces" style="@style/Btn" android:layout_width="48dp" android:layout_height="56dp"
                android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:textSize="22sp" android:autoSizeTextType="none"
                android:text="◆" android:contentDescription="@string/menu_places_map_off"/>
            <TextView android:id="@+id/btnFind" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:text="@string/find"/>
            <TextView android:id="@+id/btnMenu" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginStart="8dp" android:text="@string/menu"/>
        </LinearLayout>

        <!-- strips under the top row: the stop, the trip summary, the navigation panel, the profile -->
        <LinearLayout android:id="@+id/strips" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="72dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp">

            <LinearLayout android:id="@+id/resultsStrip" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false" android:background="@color/paper" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                android:layout_marginBottom="6dp" android:visibility="gone">
                <TextView android:id="@+id/resultsLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
                <TextView android:id="@+id/btnResultsClose" style="@style/Btn" android:layout_width="44dp" android:layout_height="44dp"
                    android:minHeight="44dp" android:minWidth="44dp" android:layout_marginStart="8dp" android:textSize="20sp" android:text="✕"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/pinStrip" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false" android:background="@color/ink" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
                <TextView android:id="@+id/pinLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="@color/paper" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
                <TextView android:id="@+id/btnRoute" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="44dp"
                    android:minHeight="44dp" android:minWidth="96dp" android:layout_marginStart="8dp" android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:textSize="14sp" android:letterSpacing="0.04" android:text="@string/go_here"/>
                <TextView android:id="@+id/btnDrop" style="@style/Btn" android:layout_width="44dp" android:layout_height="44dp"
                    android:minHeight="44dp" android:minWidth="44dp" android:layout_marginStart="8dp" android:textSize="20sp"
                    android:background="@drawable/btn_dark" android:textColor="@drawable/btn_dark_text" android:text="✕"/>
                <TextView android:id="@+id/btnDepartures" style="@style/Btn" android:layout_width="84dp" android:layout_height="44dp"
                    android:minHeight="44dp" android:layout_marginStart="8dp" android:autoSizeMaxTextSize="13sp" android:visibility="gone"
                    android:background="@drawable/btn_dark" android:textColor="@drawable/btn_dark_text" android:text="@string/departures"/>
                <TextView android:id="@+id/btnSave" style="@style/Btn" android:layout_width="44dp" android:layout_height="44dp"
                    android:minHeight="44dp" android:minWidth="44dp" android:layout_marginStart="8dp" android:textSize="22sp"
                    android:background="@drawable/btn_dark" android:textColor="@drawable/btn_dark_text" android:text="☆"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/navPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false" android:background="@color/ink" android:gravity="center_vertical"
                android:padding="8dp" android:visibility="gone">
                <com.freedomfighter.swissbikehike.TurnArrowView android:id="@+id/navArrow"
                    android:layout_width="112dp" android:layout_height="112dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingStart="8dp">
                    <TextView android:id="@+id/navDist" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/paper" android:textSize="46sp" android:textStyle="bold" android:fontFamily="monospace"
                        android:singleLine="true" android:text="--"/>
                    <TextView android:id="@+id/navStreet" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/paper" android:textSize="20sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"
                        android:visibility="gone"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false"
                        android:gravity="center_vertical">
                        <TextView android:id="@+id/navThenLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/grey" android:textSize="16sp" android:text="@string/then" android:paddingEnd="8dp"/>
                        <com.freedomfighter.swissbikehike.TurnArrowView android:id="@+id/navThenArrow"
                            android:layout_width="30dp" android:layout_height="30dp"/>
                        <TextView android:id="@+id/navThen" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/grey" android:textSize="16sp" android:fontFamily="monospace" android:paddingStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- public-transport guidance: the instruction of the moment, in big letters -->
            <LinearLayout android:id="@+id/transitPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/ink" android:padding="12dp" android:visibility="gone">
                <TextView android:id="@+id/tTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/paper" android:textSize="30sp" android:textStyle="bold" android:maxLines="2"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="32sp"
                    android:lineSpacingExtra="2dp" android:text="--"/>
                <TextView android:id="@+id/tDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/paper" android:textSize="18sp" android:maxLines="4" android:lineSpacingExtra="4dp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <com.freedomfighter.swissbikehike.ProfileView android:id="@+id/profile" android:layout_width="match_parent"
                android:layout_height="76dp" android:background="@color/ink" android:paddingStart="6dp" android:paddingEnd="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- right column: zoom and follow -->
        <LinearLayout android:id="@+id/zoomColumn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_gravity="end|bottom" android:padding="8dp" android:layout_marginBottom="24dp">
            <TextView android:id="@+id/btnZoomIn" style="@style/BtnGlyph" android:text="+"/>
            <TextView android:id="@+id/btnZoomOut" style="@style/BtnGlyph" android:text="−" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/btnFollow" style="@style/BtnGlyph" android:text="◎" android:layout_marginTop="24dp"/>
        </LinearLayout>

        <!-- status line (routing…, messages) -->
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:background="@color/ink" android:textColor="@color/paper"
            android:textSize="18sp" android:textStyle="bold" android:padding="14dp" android:visibility="gone"/>

        <TextView android:id="@+id/attribution" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:text="@string/attribution" android:textSize="10sp"
            android:textColor="@color/ink" android:background="#B3FFFFFF" android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </FrameLayout>

    <!-- route preview: summary, streets, steps, START -->
    <LinearLayout android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/paper" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="6dp" android:paddingBottom="8dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:baselineAligned="false" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/pvSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" android:maxLines="2"/>
                <TextView android:id="@+id/pvDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/ink" android:textSize="15sp" android:maxLines="3" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/pvClose" style="@style/Btn" android:layout_width="48dp" android:layout_height="48dp"
                android:minHeight="48dp" android:minWidth="48dp" android:layout_marginStart="8dp" android:textSize="20sp" android:text="✕"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/pvChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <com.freedomfighter.swissbikehike.ProfileView android:id="@+id/pvProfile" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@color/ink" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:visibility="gone"/>
        <ScrollView android:id="@+id/pvStepsScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:visibility="gone">
            <LinearLayout android:id="@+id/pvSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:baselineAligned="false" android:layout_marginTop="8dp">
            <TextView android:id="@+id/pvStepsBtn" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="48dp"
                android:minHeight="48dp" android:autoSizeMaxTextSize="14sp" android:letterSpacing="0.03"/>
            <TextView android:id="@+id/pvShare" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:minHeight="48dp" android:layout_marginStart="6dp" android:autoSizeMaxTextSize="14sp" android:letterSpacing="0.03" android:text="@string/share"/>
            <TextView android:id="@+id/pvSave" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:minHeight="48dp" android:layout_marginStart="6dp" android:autoSizeMaxTextSize="14sp" android:letterSpacing="0.03" android:text="@string/route_save"/>
        </LinearLayout>
        <TextView android:id="@+id/pvStart" style="@style/Btn" android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginTop="8dp" android:background="@drawable/btn_go" android:textColor="@drawable/btn_active_text"
            android:textSize="22sp" android:text="@string/start_nav"/>
    </LinearLayout>

    <!-- action row -->
    <LinearLayout android:id="@+id/actionRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:background="@color/paper" android:padding="6dp">
        <TextView android:id="@+id/btnPlan" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1.3"
            android:layout_height="56dp" android:letterSpacing="0.03" android:text="@string/route_plan"/>
        <TextView android:id="@+id/btnGo" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1.3"
            android:layout_height="56dp" android:layout_marginStart="6dp" android:text="@string/stop_nav" android:visibility="gone"/>
        <TextView android:id="@+id/btnRec" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp" android:text="@string/rec" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- data bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:background="@color/ink" android:paddingTop="6dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/vSpeed" style="@style/DataValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--"/>
            <TextView style="@style/DataLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/speed"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/vAlt" style="@style/DataValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--"/>
            <TextView android:id="@+id/lAlt" style="@style/DataLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/alt"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/vDist" style="@style/DataValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--"/>
            <TextView android:id="@+id/lDist" style="@style/DataLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dist"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
