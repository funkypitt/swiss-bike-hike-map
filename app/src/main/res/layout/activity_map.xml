<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ink">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/map"
            android:layout_width="match_parent" android:layout_height="match_parent"/>

        <!-- top row: mode badge left, FIND + MENU right -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="8dp" android:gravity="top">
            <TextView android:id="@+id/modeBadge" android:layout_width="wrap_content" android:layout_height="56dp"
                android:minWidth="96dp" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:gravity="center" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.12"
                android:background="@drawable/badge_walk" android:text="@string/walk"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/btnFind" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="56dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="@string/find"/>
            <TextView android:id="@+id/btnMenu" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="56dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:layout_marginStart="8dp" android:text="@string/menu"/>
        </LinearLayout>

        <!-- strips under the top row: the stop, the trip summary, the navigation panel, the profile -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="72dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp">

            <LinearLayout android:id="@+id/pinStrip" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@color/ink" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
                <TextView android:id="@+id/pinLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="@color/paper" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
                <TextView android:id="@+id/btnDrop" style="@style/Btn" android:layout_width="44dp" android:layout_height="44dp"
                    android:minHeight="44dp" android:minWidth="44dp" android:layout_marginStart="8dp" android:textSize="20sp"
                    android:background="@drawable/btn_dark" android:textColor="@drawable/btn_dark_text" android:text="✕"/>
                <TextView android:id="@+id/btnShare" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="44dp"
                    android:minHeight="44dp" android:paddingStart="12dp" android:paddingEnd="14dp" android:layout_marginStart="8dp" android:textSize="15sp"
                    android:background="@drawable/btn_dark" android:textColor="@drawable/btn_dark_text" android:text="@string/share"/>
                <TextView android:id="@+id/btnSave" style="@style/Btn" android:layout_width="44dp" android:layout_height="44dp"
                    android:minHeight="44dp" android:minWidth="44dp" android:layout_marginStart="8dp" android:textSize="22sp"
                    android:background="@drawable/btn_dark" android:textColor="@drawable/btn_dark_text" android:text="☆"/>
            </LinearLayout>

            <TextView android:id="@+id/routeStrip" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/ink" android:textColor="@color/paper" android:textSize="16sp"
                android:fontFamily="monospace" android:textStyle="bold" android:gravity="center"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone"/>

            <LinearLayout android:id="@+id/navPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@color/ink" android:gravity="center_vertical"
                android:padding="8dp" android:visibility="gone">
                <com.freedomfighter.swissbikehike.TurnArrowView android:id="@+id/navArrow"
                    android:layout_width="112dp" android:layout_height="112dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingStart="8dp">
                    <TextView android:id="@+id/navDist" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/paper" android:textSize="46sp" android:textStyle="bold" android:fontFamily="monospace"
                        android:singleLine="true" android:text="--"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:id="@+id/navThenLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/grey" android:textSize="16sp" android:text="@string/then" android:paddingEnd="8dp"/>
                        <com.freedomfighter.swissbikehike.TurnArrowView android:id="@+id/navThenArrow"
                            android:layout_width="30dp" android:layout_height="30dp"/>
                        <TextView android:id="@+id/navThen" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/grey" android:textSize="16sp" android:fontFamily="monospace" android:paddingStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.freedomfighter.swissbikehike.ProfileView android:id="@+id/profile" android:layout_width="match_parent"
                android:layout_height="76dp" android:background="@color/ink" android:paddingStart="6dp" android:paddingEnd="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- right column: zoom and follow -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_gravity="end|bottom" android:padding="8dp" android:layout_marginBottom="24dp">
            <TextView android:id="@+id/btnZoomIn" style="@style/BtnGlyph" android:text="+"/>
            <TextView android:id="@+id/btnZoomOut" style="@style/BtnGlyph" android:text="−" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/btnFollow" style="@style/BtnGlyph" android:text="◎" android:layout_marginTop="24dp"/>
        </LinearLayout>

        <!-- status line (routing…, messages) -->
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:background="@color/ink" android:textColor="@color/paper"
            android:textSize="18sp" android:textStyle="bold" android:padding="14dp" android:visibility="gone"/>

        <TextView android:id="@+id/attribution" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:text="@string/attribution" android:textSize="10sp"
            android:textColor="@color/ink" android:background="#B3FFFFFF" android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </FrameLayout>

    <!-- action row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/paper" android:padding="6dp">
        <TextView android:id="@+id/btnGo" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp" android:text="@string/go" android:enabled="false"/>
        <TextView android:id="@+id/btnNav" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp" android:text="@string/nav" android:layout_marginStart="6dp" android:enabled="false"/>
        <TextView android:id="@+id/btnRec" style="@style/Btn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp" android:text="@string/rec" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- data bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/ink" android:paddingTop="6dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/vSpeed" style="@style/DataValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--"/>
            <TextView style="@style/DataLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/speed"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/vAlt" style="@style/DataValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--"/>
            <TextView android:id="@+id/lAlt" style="@style/DataLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/alt"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/vDist" style="@style/DataValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--"/>
            <TextView android:id="@+id/lDist" style="@style/DataLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dist"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
